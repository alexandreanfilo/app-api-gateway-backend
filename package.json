{
  "name": "app-api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de integra\u00e7\u00f5es: recebe ou coleta dados, transforma e entrega em APIs de destino, com pipelines definidos em configura\u00e7\u00e3o.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:prod": "node --env-file-if-exists=.env dist/src/main",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "migrate:prod": "node --env-file-if-exists=.env dist/scripts/migrate.js up",
    "test": "jest --selectProjects unit e2e config",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects int",
    "test:all": "jest",
    "lint": "biome check --write",
    "lint:ci": "biome check",
    "depcruise": "depcruise src",
    "check": "tsc --noEmit && biome check && depcruise src",
    "test:config": "jest --selectProjects config"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/schedule": "6.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bullmq": "6.3.6",
    "consola": "3.4.2",
    "cron": "4.4.0",
    "cron-parser": "5.10.1",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "kysely": "0.28.14",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.10.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.18.0",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.3.1",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
