# Copie para .env e ajuste. NENHUM valor real de segredo entra em arquivo
# versionado -- em producao estas variaveis vem do orquestrador.

# --- obrigatorias ---------------------------------------------------------
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway

# --- opcionais, com default -----------------------------------------------
PORT=3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
PIPELINES_DIR=./pipelines

# Teto que o Express aplica antes de saber qual pipeline e. O maxBodyBytes por
# pipeline, declarado no YAML, e checado depois.
GLOBAL_MAX_BODY_BYTES=16777216

DELIVERY_CONCURRENCY=8
DRAIN_INTERVAL_SECONDS=30
# Grace: um job legitimamente delayed tem next_attempt_at no futuro e fica
# invisivel ao drenador, que assim nao briga com o backoff da fila.
DRAIN_GRACE_SECONDS=60
DRAIN_BATCH_SIZE=500
# Recorte de particao. Sem ele a consulta do drenador varre TODAS as particoes.
DRAIN_LOOKBACK_DAYS=90

RETENTION_DELIVERY_MONTHS=6
RETENTION_RUN_MONTHS=2
PARTITION_MONTHS_AHEAD=3

# --- observabilidade ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=app-api-gateway
# OTEL_SDK_DISABLED=true
# OTEL_DIAG=debug

# --- segredos dos fluxos ATIVOS -------------------------------------------
# Cada `{ secret: NOME }` do YAML procura uma variavel com este NOME, e o boot
# recusa subir se faltar alguma. Cada fluxo tem token proprio na ORIGEM e no
# DESTINO -- nada e compartilhado.
ADM_PORTO_FRANCO_TOKEN=
ADM_TSM_TOKEN=
FTO_BARCARENA_TOKEN=
FTO_BARCARENA_TSM_TOKEN=
FTO_SAO_LUIS_TOKEN=
FTO_SAO_LUIS_TSM_TOKEN=

# --- segredos de fluxo DESLIGADO ------------------------------------------
# Pipeline com `enabled: false` e inerte: o carregador nem procura o segredo.
# Estes so precisam existir se alguem religar o YAML correspondente.
#
#   parceiro-x-eventos.yaml   PARCEIRO_X_API_KEY, DESTINO_INTERNO_BEARER
#   gts-sao-luis-tsm.yaml     GTS_SAO_LUIS_USERNAME, GTS_SAO_LUIS_PASSWORD,
#                             TSM_BEARER
